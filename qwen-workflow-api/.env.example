# Copy these values from your Cloudflare Worker secrets, then rename to `.env`
# DO NOT commit real secrets.

BRIDGE_URL=https://qwen-workflow-api.qwen-workflow-api.workers.dev
API_KEY=replace-with-worker-API_KEY
WORKER_KEY=replace-with-worker-WORKER_KEY

# Optional — only needed if you want this script to also run the poller/CLI:
# QWEN_CLI_PATH=tools/qwen_cli.py
# QWEN_CLI_CONFIG_DIR=.qwen-config
# JOB_TIMEOUT=60
# TEST_PROMPT=Reply with exactly: SIMPLE_TEST_OK
