# Local / secret placeholders — never commit real keys.
# Prefer: npx wrangler secret put APMIX_API_KEY

# Upstream provider credentials (Worker secrets)
APMIX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional custom OpenAI-compatible upstream
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Gateway admin token for /admin/* routes
ADMIN_TOKEN=

# Defaults (also set in wrangler.jsonc vars)
GATEWAY_DEFAULT_PROVIDER=apmix
GATEWAY_DEFAULT_MODEL=gpt-6-luna-free
