# Local / secret placeholders — never commit real keys.
# Prefer: npx wrangler secret put APMIX_API_KEY

# Upstream provider credentials (Worker secrets)
APMIX_API_KEY=
APMIX_BASE_URL=https://api.apmix.ai/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=
UPSTREAM_BASE_URL=https://api.apmix.ai/v1

# Anthropic-style Messages API (w03)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1024

# Optional custom OpenAI-compatible upstream (w02 registry)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Generic custom upstream (w03)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_PATH=/v1/chat/completions
CUSTOM_LLM_AUTH=bearer
CUSTOM_LLM_STYLE=openai
CUSTOM_LLM_EXTRA_HEADERS_JSON=

# Gateway admin token for /admin/* routes
ADMIN_TOKEN=

# Defaults (also set in wrangler.jsonc vars)
GATEWAY_DEFAULT_PROVIDER=apmix
GATEWAY_DEFAULT_MODEL=gpt-6-luna-free
