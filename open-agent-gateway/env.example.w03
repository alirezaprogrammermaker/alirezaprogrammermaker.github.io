# w03 provider env bindings (no secrets — placeholders only)

# Anthropic-style Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1024

# Generic custom OpenAI-compatible (or anthropic-style) upstream
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_PATH=/v1/chat/completions
# bearer | x-api-key | none
CUSTOM_LLM_AUTH=bearer
# openai | anthropic
CUSTOM_LLM_STYLE=openai
# Optional JSON object of extra headers, e.g. {"X-Custom":"1"}
CUSTOM_LLM_EXTRA_HEADERS_JSON=
