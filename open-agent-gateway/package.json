{
  "name": "open-agent-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers multi-provider AI Agent gateway (OpenAI-compatible)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "types": "wrangler types && tsc --noEmit",
    "check": "wrangler check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "agents": "^0.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20250317.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
